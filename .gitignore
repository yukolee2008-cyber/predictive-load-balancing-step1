# 数据文件（可选：如果不想纳入版本控制）
data/raw/*.csv
data/processed/*.csv

# 模型文件（较大，通常不纳入版本控制）
models/*.pth
models/*.pt

# 结果文件（每次运行覆盖，可选择性提交）
